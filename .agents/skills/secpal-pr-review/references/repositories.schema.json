{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SecPal/.github/blob/main/.agents/skills/secpal-pr-review/references/repositories.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 SecPal Contributors; SPDX-License-Identifier: CC0-1.0",
  "title": "SecPal PR review workflow repository registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repositories"],
  "properties": {
    "$comment": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "fixed_thread_resolution": {
      "$ref": "#/$defs/fixed_thread_resolution",
      "description": "Required in the canonical registry; optional for schema-1.0 custom registries retained for compatibility."
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "fixed_thread_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolver",
        "required_bindings",
        "allowed_github_operations",
        "prohibited_hosted_reads",
        "prohibited_mutations",
        "readiness_authorization"
      ],
      "properties": {
        "resolver": { "const": "scripts/secpal-resolve-fixed-threads.py" },
        "required_bindings": {
          "const": [
            "repository",
            "pull_request_number",
            "repository_root",
            "expected_head",
            "reviewed_state_digest",
            "validation_evidence",
            "eligibility_evidence",
            "thread_ids"
          ]
        },
        "allowed_github_operations": {
          "const": [
            "READ_NAMED_REVIEW_THREAD",
            "READ_AUTHENTICATED_FOLLOW_UP_WORK_GRAPH",
            "AUTHENTICATE_LIFECYCLE_PUBLICATION_PROTECTION",
            "RESOLVE_NAMED_REVIEW_THREAD"
          ]
        },
        "prohibited_hosted_reads": {
          "const": [
            "GITHUB_ACTIONS",
            "CODEQL",
            "CHECK_SUITES",
            "COMMIT_STATUSES",
            "REQUIRED_CHECKS",
            "MERGEABILITY",
            "BRANCH_PROTECTION",
            "MERGE_READINESS"
          ]
        },
        "prohibited_mutations": {
          "const": ["REVIEW_REQUEST", "READY_TRANSITION", "MERGE", "LABEL", "GENERIC_COMMENT"]
        },
        "readiness_authorization": { "const": "SEPARATE_EXPLICIT_WORKFLOW" }
      }
    },
    "firstReadyExecutorBootstrapSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "subtype",
        "repository",
        "delivery_issue",
        "pull_request",
        "source_head_sha",
        "source_tree_sha",
        "source_parent_sha",
        "validation_receipt_digest",
        "final_attestation_digest",
        "source_signer_identity",
        "implementation_path",
        "entrypoint",
        "purpose",
        "source_pr_state",
        "source_pr_draft",
        "source_base_ref",
        "admission_digest"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "kind": { "const": "BOOTSTRAP_SOURCE_ADMISSION" },
        "subtype": { "const": "FIRST_READY_EXECUTOR_BOOTSTRAP_SOURCE" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "delivery_issue": { "type": "integer", "minimum": 1 },
        "pull_request": { "type": "integer", "minimum": 1 },
        "source_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "source_tree_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "source_parent_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "validation_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "final_attestation_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_signer_identity": { "type": "string", "minLength": 1 },
        "implementation_path": { "const": "scripts/secpal_pr_review/lifecycle_execution.py" },
        "entrypoint": { "const": "execute_lifecycle_transition" },
        "purpose": { "const": "FIRST_READY_EXECUTOR_BOOTSTRAP" },
        "source_pr_state": { "const": "OPEN" },
        "source_pr_draft": { "const": true },
        "source_base_ref": { "const": "main" },
        "admission_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidence_loss_recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "kind",
            "historical_evidence_status",
            "source_admission_digest",
            "recovery_validation",
            "technical_security_gate",
            "recovery_digest"
          ],
          "properties": {
            "schema_version": { "const": "1.0" },
            "kind": { "const": "BOOTSTRAP_SOURCE_EVIDENCE_LOSS_RECOVERY" },
            "historical_evidence_status": {
              "const": "HISTORICAL_EVIDENCE_UNAVAILABLE_BUT_EXACT_RECOVERY_AUTHORIZED"
            },
            "source_admission_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "recovery_validation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source_head_sha",
                "source_tree_sha",
                "command_set_digest",
                "result",
                "validation_digest"
              ],
              "properties": {
                "kind": { "const": "EXACT_BOOTSTRAP_SOURCE_RECOVERY_VALIDATION" },
                "source_head_sha": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "source_tree_sha": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "command_set_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "result": { "const": "PASSED" },
                "validation_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            },
            "technical_security_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "source_head_sha",
                "source_tree_sha",
                "review_scope",
                "feedback_inventory_digest",
                "resolved_review_thread_count",
                "conversation_comment_count",
                "review_decision",
                "result",
                "gate_digest"
              ],
              "properties": {
                "kind": { "const": "BOOTSTRAP_SOURCE_RECOVERY_TECHNICAL_SECURITY_GATE" },
                "source_head_sha": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "source_tree_sha": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                "review_scope": { "const": "EXACT_IMMUTABLE_BOOTSTRAP_EXECUTOR" },
                "feedback_inventory_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "resolved_review_thread_count": { "const": 2 },
                "conversation_comment_count": { "const": 0 },
                "review_decision": { "const": "NONE" },
                "result": { "const": "NO_OPEN_TECHNICAL_OR_SECURITY_FINDINGS" },
                "gate_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            },
            "recovery_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "prReviewEvidenceHelperSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "subtype",
        "repository",
        "delivery_issue",
        "pull_request",
        "source_head_sha",
        "source_tree_sha",
        "source_parent_sha",
        "validation_receipt_digest",
        "final_attestation_digest",
        "source_signer_identity",
        "implementation_path",
        "implementation_blob_oid",
        "purpose",
        "source_pr_state",
        "source_pr_draft",
        "source_base_ref",
        "policy_source",
        "admission_digest"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "kind": { "const": "BOOTSTRAP_SOURCE_ADMISSION" },
        "subtype": { "const": "PR_REVIEW_EVIDENCE_HELPER_SOURCE" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "delivery_issue": { "type": "integer", "minimum": 1 },
        "pull_request": { "type": "integer", "minimum": 1 },
        "source_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "source_tree_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "source_parent_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "validation_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "final_attestation_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_signer_identity": { "type": "string", "minLength": 1 },
        "implementation_path": { "const": "scripts/secpal-pr-review.py" },
        "implementation_blob_oid": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "purpose": { "const": "PR_REVIEW_EVIDENCE_HELPER_SOURCE_ADMISSION" },
        "source_pr_state": { "const": "OPEN" },
        "source_pr_draft": { "const": true },
        "source_base_ref": { "const": "main" },
        "policy_source": { "const": "ACCEPTED_MAIN_REPOSITORY_REGISTRY" },
        "admission_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "preEnrollmentDraftIntegrationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "subtype",
        "repository",
        "delivery_issue",
        "pull_request",
        "source_head_sha",
        "source_tree_sha",
        "source_parent_sha",
        "source_signer_identity",
        "signer_policy_identity",
        "implementation_path",
        "implementation_blob_oid",
        "entrypoint",
        "command",
        "purpose",
        "source_pr_state",
        "source_pr_draft",
        "source_base_ref",
        "policy_source",
        "historical_evidence_status",
        "validation_registry_path",
        "validation_command_set",
        "validation_command_set_digest",
        "validation_results",
        "validation_result_digest",
        "admission_digest"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "kind": { "const": "BOOTSTRAP_SOURCE_ADMISSION" },
        "subtype": { "const": "PRE_ENROLLMENT_DRAFT_INTEGRATION_SOURCE" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "delivery_issue": { "type": "integer", "minimum": 1 },
        "pull_request": { "type": "integer", "minimum": 1 },
        "source_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "source_tree_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "source_parent_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "source_signer_identity": { "type": "string", "minLength": 1 },
        "signer_policy_identity": { "const": "MAINTAINED_LIFECYCLE_SIGNER_POLICY" },
        "implementation_path": { "const": "scripts/secpal-pr-review-actions.py" },
        "implementation_blob_oid": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "entrypoint": { "const": "main" },
        "command": { "const": "integrate-pre-enrollment-draft" },
        "purpose": { "const": "PRE_ENROLLMENT_IMPLEMENTATION_BOOTSTRAP" },
        "source_pr_state": { "const": "OPEN" },
        "source_pr_draft": { "const": true },
        "source_base_ref": { "const": "main" },
        "policy_source": { "const": "ACCEPTED_MAIN_REPOSITORY_REGISTRY" },
        "historical_evidence_status": { "const": "HISTORICAL_EVIDENCE_UNAVAILABLE" },
        "validation_registry_path": {
          "const": ".agents/skills/secpal-pr-review/references/repositories.json"
        },
        "validation_command_set": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv", "working_directory", "purpose"],
            "properties": {
              "argv": {
                "type": "array",
                "prefixItems": [
                  { "const": "python3" },
                  { "const": "-m" },
                  { "const": "unittest" },
                  { "type": "string", "pattern": "^tests/[a-z0-9-]+-unit\\.py$" }
                ],
                "minItems": 4,
                "maxItems": 4
              },
              "working_directory": { "const": "." },
              "purpose": { "type": "string", "minLength": 1 }
            }
          }
        },
        "validation_command_set_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validation_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command_digest", "exit_status", "successful"],
            "properties": {
              "command_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "exit_status": { "const": 0 },
              "successful": { "const": true }
            }
          }
        },
        "validation_result_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admission_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "default_branch",
        "allowed_base_repositories",
        "reviewer_identities",
        "focused_validation",
        "required_local_validation",
        "signature_policy",
        "check_policy",
        "manual_gates",
        "unsupported_operations",
        "maximum_api_calls",
        "maximum_items",
        "maximum_threads",
        "maximum_comments",
        "maximum_reactions"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "default_branch": { "type": "string", "minLength": 1 },
        "allowed_base_repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
        },
        "reviewer_identities": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "object" }
        },
        "focused_validation": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "required_local_validation": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "final_eligibility_absence_recoveries": {
          "type": "array",
          "items": { "$ref": "#/$defs/final_eligibility_absence_recovery" }
        },
        "signature_policy": { "type": "object" },
        "lifecycle_authority_policy": {
          "$ref": "#/$defs/lifecycle_authority_policy"
        },
        "check_policy": { "type": "object" },
        "manual_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unsupported_operations": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REVIEW_REQUEST",
              "READY_TRANSITION",
              "LABEL",
              "ISSUE",
              "REVIEW_SUBMISSION",
              "MERGE",
              "AUTO_MERGE",
              "COMMENT_DELETE",
              "REVIEW_DISMISSAL",
              "BRANCH_WRITE"
            ]
          }
        },
        "maximum_api_calls": { "type": "integer", "minimum": 1 },
        "maximum_items": { "type": "integer", "minimum": 1 },
        "maximum_threads": { "type": "integer", "minimum": 1 },
        "maximum_comments": { "type": "integer", "minimum": 1 },
        "maximum_reactions": { "type": "integer", "minimum": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "working_directory", "purpose"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "working_directory": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "execution_policy": { "enum": ["always", "focused-only"] }
      }
    },
    "final_eligibility_absence_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "repository",
        "delivery_issue",
        "pull_request",
        "final_head_sha",
        "final_tree_sha",
        "final_reviewed_state_digest",
        "final_validation_receipt_digest",
        "final_attestation_digest",
        "final_delivery_signer",
        "expected_final_reviewed_thread_count",
        "expected_final_eligibility_status",
        "recovery_digest"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "kind": { "const": "FINAL_ELIGIBILITY_ABSENCE_RECOVERY" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "delivery_issue": { "type": "integer", "minimum": 1 },
        "pull_request": { "type": "integer", "minimum": 1 },
        "final_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "final_tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "final_reviewed_state_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "final_validation_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "final_attestation_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "final_delivery_signer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "fingerprint"],
          "properties": {
            "format": { "enum": ["ssh", "openpgp"] },
            "fingerprint": { "type": "string", "minLength": 1 }
          }
        },
        "expected_final_reviewed_thread_count": { "const": 0 },
        "expected_final_eligibility_status": { "const": "ABSENT_NOT_AUTHENTICATED" },
        "recovery_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "lifecycle_authority_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "accepted_formats",
        "signers",
        "transition_signer_identities",
        "authority_signer_identities",
        "publication_signer_identities",
        "genesis_admission_signer_identities",
        "legacy_adoption_signer_identities",
        "publication_branch",
        "publication_remote_url",
        "publication_ruleset_id",
        "publication_required_rules",
        "bootstrap_genesis_repairs",
        "bootstrap_source_admissions",
        "historical_compatibility_publications",
        "delivery_initializations"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "accepted_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ssh", "openpgp"] }
        },
        "signers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "ssh_public_keys", "openpgp_fingerprints"],
            "properties": {
              "identity": { "type": "string", "minLength": 1 },
              "ssh_public_keys": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^ssh-(ed25519|rsa) [A-Za-z0-9+/=]+$" }
              },
              "openpgp_fingerprints": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[0-9A-F]{40,64}$" }
              }
            }
          }
        },
        "transition_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "authority_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "publication_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "genesis_admission_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "legacy_adoption_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "publication_branch": {
          "type": "string",
          "const": "refs/heads/secpal-lifecycle-publications"
        },
        "publication_remote_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
        },
        "publication_ruleset_id": {
          "type": "integer",
          "minimum": 1
        },
        "publication_required_rules": {
          "const": ["deletion", "non_fast_forward"]
        },
        "bootstrap_genesis_repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repair_issue",
              "delivery_issue",
              "pull_request",
              "initial_head_sha",
              "initialization_digest",
              "validation_receipt_digest",
              "final_attestation_digest",
              "enrollment_publication_oid",
              "enrollment_publication_digest"
            ],
            "properties": {
              "repair_issue": { "type": "integer", "minimum": 1 },
              "delivery_issue": { "type": "integer", "minimum": 1 },
              "pull_request": { "type": "integer", "minimum": 1 },
              "initial_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
              "initialization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "validation_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "final_attestation_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "enrollment_publication_oid": {
                "type": "string",
                "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "enrollment_publication_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "bootstrap_source_admissions": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/firstReadyExecutorBootstrapSource" },
              { "$ref": "#/$defs/prReviewEvidenceHelperSource" },
              { "$ref": "#/$defs/preEnrollmentDraftIntegrationSource" }
            ]
          }
        },
        "historical_compatibility_publications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "delivery_issue",
              "pull_request",
              "initial_head_sha",
              "initialization_digest",
              "enrollment_publication_oid",
              "enrollment_publication_digest",
              "historical_proof_mode"
            ],
            "properties": {
              "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
              "delivery_issue": { "type": "integer", "minimum": 1 },
              "pull_request": { "type": "integer", "minimum": 1 },
              "initial_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
              "initialization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "enrollment_publication_oid": {
                "type": "string",
                "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "enrollment_publication_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "historical_proof_mode": { "const": "native_lifecycle" }
            }
          }
        },
        "delivery_initializations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "delivery_issue",
              "pull_request",
              "initial_head_sha",
              "initialization_digest",
              "current_pull_request",
              "current_head_sha",
              "current_authority_digest"
            ],
            "properties": {
              "delivery_issue": { "type": "integer", "minimum": 1 },
              "pull_request": { "type": "integer", "minimum": 1 },
              "initial_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
              "initialization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "current_pull_request": { "type": "integer", "minimum": 1 },
              "current_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
              "current_authority_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
