{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SecPal/.github/blob/main/.agents/skills/secpal-pr-review/references/repositories.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 SecPal Contributors; SPDX-License-Identifier: CC0-1.0",
  "title": "SecPal PR review workflow repository registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repositories"],
  "properties": {
    "$comment": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "fixed_thread_resolution": {
      "$ref": "#/$defs/fixed_thread_resolution",
      "description": "Required in the canonical registry; optional for schema-1.0 custom registries retained for compatibility."
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "fixed_thread_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolver",
        "required_bindings",
        "allowed_github_operations",
        "prohibited_hosted_reads",
        "prohibited_mutations",
        "readiness_authorization"
      ],
      "properties": {
        "resolver": { "const": "scripts/secpal-resolve-fixed-threads.py" },
        "required_bindings": {
          "const": [
            "repository",
            "pull_request_number",
            "repository_root",
            "expected_head",
            "reviewed_state_digest",
            "validation_evidence",
            "eligibility_evidence",
            "thread_ids"
          ]
        },
        "allowed_github_operations": {
          "const": [
            "READ_NAMED_REVIEW_THREAD",
            "READ_AUTHENTICATED_FOLLOW_UP_WORK_GRAPH",
            "RESOLVE_NAMED_REVIEW_THREAD"
          ]
        },
        "prohibited_hosted_reads": {
          "const": [
            "GITHUB_ACTIONS",
            "CODEQL",
            "CHECK_SUITES",
            "COMMIT_STATUSES",
            "REQUIRED_CHECKS",
            "MERGEABILITY",
            "BRANCH_PROTECTION",
            "MERGE_READINESS"
          ]
        },
        "prohibited_mutations": {
          "const": ["REVIEW_REQUEST", "READY_TRANSITION", "MERGE", "LABEL", "GENERIC_COMMENT"]
        },
        "readiness_authorization": { "const": "SEPARATE_EXPLICIT_WORKFLOW" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "default_branch",
        "allowed_base_repositories",
        "reviewer_identities",
        "focused_validation",
        "required_local_validation",
        "signature_policy",
        "check_policy",
        "manual_gates",
        "unsupported_operations",
        "maximum_api_calls",
        "maximum_items",
        "maximum_threads",
        "maximum_comments",
        "maximum_reactions"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "default_branch": { "type": "string", "minLength": 1 },
        "allowed_base_repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
        },
        "reviewer_identities": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "object" }
        },
        "focused_validation": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "required_local_validation": { "type": "array", "items": { "$ref": "#/$defs/command" } },
        "signature_policy": { "type": "object" },
        "lifecycle_authority_policy": {
          "$ref": "#/$defs/lifecycle_authority_policy"
        },
        "check_policy": { "type": "object" },
        "manual_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unsupported_operations": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REVIEW_REQUEST",
              "READY_TRANSITION",
              "LABEL",
              "ISSUE",
              "REVIEW_SUBMISSION",
              "MERGE",
              "AUTO_MERGE",
              "COMMENT_DELETE",
              "REVIEW_DISMISSAL",
              "BRANCH_WRITE"
            ]
          }
        },
        "maximum_api_calls": { "type": "integer", "minimum": 1 },
        "maximum_items": { "type": "integer", "minimum": 1 },
        "maximum_threads": { "type": "integer", "minimum": 1 },
        "maximum_comments": { "type": "integer", "minimum": 1 },
        "maximum_reactions": { "type": "integer", "minimum": 1 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "working_directory", "purpose"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "working_directory": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "execution_policy": { "enum": ["always", "focused-only"] }
      }
    },
    "lifecycle_authority_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "accepted_formats",
        "signers",
        "transition_signer_identities",
        "authority_signer_identities",
        "publication_signer_identities",
        "genesis_admission_signer_identities",
        "legacy_adoption_signer_identities",
        "publication_branch",
        "publication_remote_url",
        "publication_ruleset_id",
        "publication_required_rules",
        "bootstrap_genesis_repairs",
        "delivery_initializations"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "accepted_formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ssh", "openpgp"] }
        },
        "signers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "ssh_public_keys", "openpgp_fingerprints"],
            "properties": {
              "identity": { "type": "string", "minLength": 1 },
              "ssh_public_keys": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^ssh-(ed25519|rsa) [A-Za-z0-9+/=]+$" }
              },
              "openpgp_fingerprints": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[0-9A-F]{40,64}$" }
              }
            }
          }
        },
        "transition_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "authority_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "publication_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "genesis_admission_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "legacy_adoption_signer_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "publication_branch": {
          "type": "string",
          "const": "refs/heads/secpal-lifecycle-publications"
        },
        "publication_remote_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
        },
        "publication_ruleset_id": {
          "type": "integer",
          "minimum": 1
        },
        "publication_required_rules": {
          "const": ["deletion", "non_fast_forward"]
        },
        "bootstrap_genesis_repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repair_issue",
              "delivery_issue",
              "pull_request",
              "initial_head_sha",
              "initialization_digest",
              "validation_receipt_digest",
              "final_attestation_digest",
              "enrollment_publication_oid",
              "enrollment_publication_digest"
            ],
            "properties": {
              "repair_issue": { "type": "integer", "minimum": 1 },
              "delivery_issue": { "type": "integer", "minimum": 1 },
              "pull_request": { "type": "integer", "minimum": 1 },
              "initial_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
              "initialization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "validation_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "final_attestation_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "enrollment_publication_oid": {
                "type": "string",
                "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "enrollment_publication_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "delivery_initializations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "delivery_issue",
              "pull_request",
              "initial_head_sha",
              "initialization_digest",
              "current_pull_request",
              "current_head_sha",
              "current_authority_digest"
            ],
            "properties": {
              "delivery_issue": { "type": "integer", "minimum": 1 },
              "pull_request": { "type": "integer", "minimum": 1 },
              "initial_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
              "initialization_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "current_pull_request": { "type": "integer", "minimum": 1 },
              "current_head_sha": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
              "current_authority_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
