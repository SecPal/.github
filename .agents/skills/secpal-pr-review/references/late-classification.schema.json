{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SecPal/.github/blob/main/.agents/skills/secpal-pr-review/references/late-classification.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 SecPal Contributors; SPDX-License-Identifier: CC0-1.0",
  "title": "SecPal authenticated post-push late-feedback classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repository",
    "delivery_issue_number",
    "pull_request_number",
    "head_sha",
    "delivery_signer",
    "authorized_purpose",
    "finding_id",
    "finding_evidence_digest",
    "thread"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "LATE_FEEDBACK_CLASSIFICATION" },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "delivery_issue_number": { "type": "integer", "minimum": 1 },
    "pull_request_number": { "type": "integer", "minimum": 1 },
    "head_sha": { "$ref": "#/$defs/oid" },
    "delivery_signer": { "$ref": "#/$defs/signer" },
    "authorized_purpose": { "const": "AUTHORIZE_LATE_FEEDBACK_DISPOSITION" },
    "finding_id": { "$ref": "#/$defs/identity" },
    "finding_evidence_digest": { "$ref": "#/$defs/digest" },
    "thread": { "$ref": "#/$defs/thread" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u0020\\u007f]+$"
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "fingerprint"],
      "properties": {
        "format": { "enum": ["ssh", "openpgp"] },
        "fingerprint": {
          "type": "string",
          "pattern": "^(?:SHA256:[A-Za-z0-9+/]+={0,2}|[0-9A-F]{40,64})$"
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "technically_blocking": { "const": false } },
            "required": ["technically_blocking"]
          },
          "then": {
            "properties": { "technical_blockers": { "maxItems": 0 } }
          },
          "else": {
            "properties": { "technical_blockers": { "minItems": 1 } }
          }
        }
      ],
      "required": [
        "thread_id",
        "top_level_comment_node_id",
        "top_level_comment_database_id",
        "finding_body_digest",
        "reply_state_digest",
        "reply_count",
        "is_resolved",
        "is_outdated",
        "classification",
        "disposition",
        "technically_blocking",
        "technical_blockers"
      ],
      "properties": {
        "thread_id": {
          "type": "string",
          "pattern": "^PRRT_[A-Za-z0-9_-]+$"
        },
        "top_level_comment_node_id": { "$ref": "#/$defs/identity" },
        "top_level_comment_database_id": { "type": "integer", "minimum": 1 },
        "finding_body_digest": { "$ref": "#/$defs/digest" },
        "reply_state_digest": { "$ref": "#/$defs/digest" },
        "reply_count": { "type": "integer", "minimum": 0 },
        "is_resolved": { "const": false },
        "is_outdated": { "type": "boolean" },
        "classification": { "const": "INVALID_FALSE_OR_MISLEADING" },
        "disposition": { "const": "DISPROVEN_WITH_EVIDENCE" },
        "technically_blocking": { "type": "boolean" },
        "technical_blockers": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["P1", "P2", "SECURITY", "AUTHENTICATION", "INTEGRITY", "FAIL_OPEN"]
          }
        }
      }
    }
  }
}
