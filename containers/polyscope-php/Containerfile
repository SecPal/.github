FROM docker.io/library/nginx:1.30.7-alpine3.24-slim@sha256:8c950211a641ec5b23f265450517001f6bcca533666120ebe36cb4cff3d00a55 AS preview-nginx
RUN apk add --no-cache libcrypto3=3.5.9-r1 libssl3=3.5.9-r1 zlib=1.4-r0

FROM docker.io/library/composer:2.11.1@sha256:8de2184c6de224f4689e8f80ed5f5edaf0030b6b8b7839a22a2bcb6722ac87d0 AS composer
FROM docker.io/library/php:8.4.28-fpm-alpine3.24@sha256:c0e41e0c856bf97b2e749f40a804031ce938d0d496c4c7d91ad416d993172826 AS php

FROM php AS sqlite-build
ARG SOURCE_DATE_EPOCH=0
COPY sqlite /build/sqlite
WORKDIR /build/sqlite
RUN ./build.sh

FROM php
# Use the API's signed SQLite package and hash-locked Python dependency graph.
COPY python/opentimestamps-requirements.txt /tmp/opentimestamps-requirements.txt
RUN --mount=type=bind,from=sqlite-build,source=/out,target=/tmp/secpal-sqlite,ro \
    apk add --no-cache --no-network --keys-dir=/tmp/secpal-sqlite/keys \
        --repositories-file=/dev/null --repository=/tmp/secpal-sqlite sqlite-libs=3.54.0-r0 \
    && install -D -m 0644 /tmp/secpal-sqlite/provenance.json /usr/share/secpal/sqlite-build.json
RUN apk add --no-cache --virtual .build-deps \
        autoconf=2.73-r0 dpkg-dev=1.23.7-r0 dpkg=1.23.7-r0 file=5.47-r2 \
        g++=15.2.0-r5 gcc=15.2.0-r5 musl-dev=1.2.6-r3 make=4.4.1-r4 pkgconf=2.5.1-r0 re2c=4.5.1-r0 \
        gettext-dev=1.0-r0 icu-dev=78.1-r0 libzip-dev=1.11.4-r2 postgresql18-dev=18.7-r0 py3-pip=26.1.2-r0 \
    && docker-php-ext-install -j2 bcmath gettext intl pcntl pdo_pgsql pgsql zip \
    && apk add --no-cache \
        git=2.54.1-r0 bash=5.3.9-r1 gettext=1.0-r0 ripgrep=15.1.0-r0 \
        gettext-libs=1.0-r0 icu-libs=78.1-r0 icu-data-full=78.1-r0 libpq=18.7-r0 libzip=1.11.4-r2 \
        python3=3.14.10-r1 libxml2=2.13.9-r3 curl=8.23.0-r0 libcurl=8.23.0-r0 brotli-libs=1.2.1-r0 \
    && pip3 install --break-system-packages --no-cache-dir --only-binary=:all: \
        --require-hashes -r /tmp/opentimestamps-requirements.txt \
    && python3 -m pip check \
    && apk del --no-network .build-deps \
    && rm -rf /tmp/opentimestamps-requirements.txt /usr/local/include/php /usr/src/php* \
        /usr/local/etc/php-fpm.d \
    && rm -f /usr/local/bin/phpize /usr/local/bin/php-config \
        /usr/local/bin/docker-php-ext-* /usr/local/bin/docker-php-source \
    && addgroup -g 1000 developer \
    && adduser -D -u 1000 -G developer developer \
    && cp "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini" \
    && printf 'memory_limit=512M\n' > "$PHP_INI_DIR/conf.d/zz-secpal-development.ini"
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
ENV APP_ENV=local APP_DEBUG=false HOME=/home/developer
USER 1000:1000
WORKDIR /app
ENTRYPOINT []
CMD ["php", "--version"]
