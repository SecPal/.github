  "non_manifest_rules": [
    {
      "id": "spdx-dependency-inventory",
      "path_regex": "(^|/)dependencies\\.spdx\\.json$",
      "case_insensitive": false,
      "content_kind": "spdx-json-document",
      "candidate_rule": "dependency-named-file",
      "authority": "secpal-reviewed-non-manifest",
      "justification": "Prevents a known SPDX dependency inventory from entering the unknown-manifest backstop."
    }
