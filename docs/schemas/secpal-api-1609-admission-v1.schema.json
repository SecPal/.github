{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SecPal/.github/docs/schemas/secpal-api-1609-admission-v1.schema.json",
  "title": "One-time API 1609 security-improvement admission input",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "user": {
      "type": "object",
      "required": ["login", "id"],
      "properties": {
        "login": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "commit": {
      "type": "object",
      "required": ["sha", "author", "commit"],
      "properties": {
        "sha": {
          "$ref": "#/$defs/sha"
        },
        "author": {
          "$ref": "#/$defs/user"
        },
        "commit": {
          "type": "object",
          "required": ["tree", "verification"],
          "properties": {
            "tree": {
              "type": "object",
              "required": ["sha"],
              "properties": {
                "sha": {
                  "$ref": "#/$defs/sha"
                }
              }
            },
            "verification": {
              "type": "object",
              "required": ["verified"],
              "properties": {
                "verified": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["merge_base_commit", "status", "ahead_by"],
      "properties": {
        "merge_base_commit": {
          "type": "object",
          "required": ["sha"],
          "properties": {
            "sha": {
              "$ref": "#/$defs/sha"
            }
          }
        },
        "status": {
          "type": "string"
        },
        "ahead_by": {
          "type": "integer"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {
          "const": "SecPal/api"
        },
        "commit": {
          "$ref": "#/$defs/sha"
        },
        "tree": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_digest",
        "raw_grype_sha256",
        "raw_trivy_sha256",
        "association_sha256",
        "evaluation"
      ],
      "properties": {
        "config_digest": {
          "$ref": "#/$defs/digest"
        },
        "raw_grype_sha256": {
          "$ref": "#/$defs/digest"
        },
        "raw_trivy_sha256": {
          "$ref": "#/$defs/digest"
        },
        "association_sha256": {
          "$ref": "#/$defs/digest"
        },
        "evaluation": {
          "$ref": "secpal-vulnerability-evaluation-v1.schema.json"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "bundle"],
      "properties": {
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "bundle_sha256",
            "valid_from",
            "expires_at",
            "rationale",
            "operator",
            "security_review"
          ],
          "properties": {
            "schema_version": {
              "const": "secpal-api-1609-admission-v1"
            },
            "bundle_sha256": {
              "$ref": "#/$defs/digest"
            },
            "valid_from": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["login", "comment_id", "body_sha256"],
              "properties": {
                "login": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\[bot\\])?$"
                },
                "comment_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "body_sha256": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            "security_review": {
              "type": "object",
              "additionalProperties": false,
              "required": ["login", "issue_number", "comment_id", "body_sha256", "conclusion"],
              "properties": {
                "login": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\[bot\\])?$"
                },
                "body_sha256": {
                  "$ref": "#/$defs/digest"
                },
                "conclusion": {
                  "const": "SECURITY_IMPROVEMENT_WITH_NO_UNREVIEWED_NEW_OR_WORSENED_RISKS"
                },
                "issue_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "comment_id": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "source",
            "index_digest",
            "runtime",
            "baseline_source",
            "platforms",
            "baseline_platforms",
            "evidence",
            "policy_sha256"
          ],
          "properties": {
            "scope": {
              "const": "SecPal/api#1609"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "index_digest": {
              "$ref": "#/$defs/digest"
            },
            "runtime": {
              "const": {
                "frankenphp": "1.13.2",
                "php": "8.4.27",
                "distribution": "bookworm",
                "fixed_cves": ["CVE-2026-109618", "CVE-2026-109619"]
              }
            },
            "baseline_source": {
              "$ref": "#/$defs/source"
            },
            "platforms": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/platform"
              }
            },
            "baseline_platforms": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/platform"
              }
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_security",
                "provenance",
                "php2shell_patch",
                "native_compatibility",
                "rollback_and_containment",
                "residual_risk_reassessment"
              ],
              "properties": {
                "source_security": {
                  "$ref": "#/$defs/digest"
                },
                "provenance": {
                  "$ref": "#/$defs/digest"
                },
                "php2shell_patch": {
                  "$ref": "#/$defs/digest"
                },
                "native_compatibility": {
                  "$ref": "#/$defs/digest"
                },
                "rollback_and_containment": {
                  "$ref": "#/$defs/digest"
                },
                "residual_risk_reassessment": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            "policy_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "authority": {
          "type": "object",
          "required": [
            "operator",
            "security_review",
            "operator_permission",
            "source_commit",
            "source_comparison",
            "baseline_commit",
            "baseline_comparison"
          ],
          "properties": {
            "operator": {
              "type": "object",
              "required": ["id", "body", "user", "issue_url", "created_at", "updated_at"],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "user": {
                  "$ref": "#/$defs/user"
                },
                "issue_url": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "security_review": {
              "type": "object",
              "required": ["id", "body", "user", "issue_url", "created_at", "updated_at"],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "user": {
                  "$ref": "#/$defs/user"
                },
                "issue_url": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "operator_permission": {
              "type": "object",
              "required": ["permission", "user"],
              "properties": {
                "permission": {
                  "type": "string"
                },
                "user": {
                  "$ref": "#/$defs/user"
                }
              }
            },
            "source_commit": {
              "$ref": "#/$defs/commit"
            },
            "source_comparison": {
              "$ref": "#/$defs/comparison"
            },
            "baseline_commit": {
              "$ref": "#/$defs/commit"
            },
            "baseline_comparison": {
              "$ref": "#/$defs/comparison"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "admitted_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "admission",
        "expires_at",
        "decision_sha256",
        "bundle_sha256",
        "source",
        "index_digest",
        "decision_provenance",
        "policy_results"
      ],
      "properties": {
        "schema_version": {
          "const": "secpal-api-1609-admission-v1"
        },
        "admission": {
          "const": "ADMITTED_WITH_KNOWN_FINDINGS"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "decision_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/digest"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "index_digest": {
          "$ref": "#/$defs/digest"
        },
        "decision_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "path", "verified_current_commit"],
          "properties": {
            "repository": {
              "const": "SecPal/.github"
            },
            "commit": {
              "$ref": "#/$defs/sha"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "verified_current_commit": {
              "$ref": "#/$defs/sha"
            }
          }
        },
        "policy_results": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "secpal-vulnerability-result-v1.schema.json"
          }
        }
      }
    },
    "denied_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "admission", "failure"],
      "properties": {
        "schema_version": {
          "const": "secpal-api-1609-admission-v1"
        },
        "admission": {
          "const": "DENIED"
        },
        "failure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/admitted_result"
    },
    {
      "$ref": "#/$defs/denied_result"
    }
  ]
}
